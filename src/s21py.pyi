from typing import Any

class S21_Stack:
    def __init__(self) -> None: ...
    def push(self, value: Any) -> None: ...
    def pop(self) -> None: ...
    def top(self) -> Any: ...
    def empty(self) -> bool: ...
    def size(self) -> int: ...

class S21_Queue:
    def __init__(self) -> None: ...
    def push(self, value: Any) -> None: ...
    def pop(self) -> None: ...
    def front(self) -> Any: ...
    def back(self) -> Any: ... 
    def empty(self) -> bool: ...
    def size(self) -> int: ...